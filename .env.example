# ── WA Gateway — Production Environment Variables ─────────────────────────────
# Salin file ini menjadi .env dan isi dengan nilai yang sebenarnya.
# JANGAN commit file .env ke git!

# ── Hermes Agent ──────────────────────────────────────────────────────────────
HERMES_API_URL=http://hermes:8642/v1/responses
HERMES_API_KEY=GANTI_DENGAN_HERMES_API_KEY_ANDA
HERMES_SECRET=GANTI_DENGAN_SECRET_RANDOM_PANJANG
# (Opsional) Nama profile Hermes khusus yang ingin digunakan
HERMES_PROFILE=

# ── Express Server ────────────────────────────────────────────────────────────
EXPRESS_PORT=4849

# ── WhatsApp Authorization ───────────────────────────────────────────────────
# Nomor WhatsApp Owner (format: 628xxx, bisa dipisah koma untuk multiple owner)
OWNER_NUMBER=628xxxxxxxxxx

# Daftar nomor anggota/karyawan yang diizinkan memanggil bot di grup (pisahkan koma)
ALLOWED_USERS=

# Daftar ID grup WhatsApp perusahaan yang diizinkan (pisahkan koma, contoh: 120363xxx@g.us)
# Kosongkan atau isi * jika ingin mengizinkan semua grup di mana bot di-tag
ALLOWED_GROUPS=
