# ── WA Gateway — Production Environment Variables ─────────────────────────────
# Salin file ini menjadi .env dan isi dengan nilai yang sebenarnya.
# JANGAN commit file .env ke git!

# ── CORE Database (postgres-master di STACK 4) ────────────────────────────────
# Sesuaikan dengan kredensial yang Anda set di STACK 4 (CORE)
CORE_DB_USER=ferdipostgree
CORE_DB_PASSWORD=GANTI_DENGAN_PASSWORD_POSTGRES_MASTER

# ── Redis (redis-queue di STACK 4, tidak perlu ubah selama data-tier aktif) ───
# Digunakan untuk: rate limiting per user & deduplication pesan
REDIS_URL=redis://redis-queue:6379

# ── Hermes Agent ──────────────────────────────────────────────────────────────
HERMES_API_URL=http://wabot-hermes:8689/v1/responses
HERMES_API_KEY=GANTI_DENGAN_HERMES_API_KEY_ANDA
HERMES_SECRET=GANTI_DENGAN_SECRET_RANDOM_PANJANG
OPENROUTER_API_KEY=GANTI_DENGAN_OPENROUTER_API_KEY_ANDA

# ── Express Server ────────────────────────────────────────────────────────────
EXPRESS_PORT=4849

# ── Admin Panel Auth ──────────────────────────────────────────────────────────
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_SECRET_JWT_YANG_SANGAT_PANJANG

# ── CORS: URL Production Admin Panel di Vercel ───────────────────────────────
ALLOWED_ORIGIN=https://your-admin-panel.vercel.app
